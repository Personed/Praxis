{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "vite/client"],
    "paths": {
      "@renderer/*": ["./src/renderer/src/*"],
      "@preload/*": ["./src/preload/*"],
      "@main/*": ["./src/main/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "scripts/case-collisions*.ts"
  ]
}
