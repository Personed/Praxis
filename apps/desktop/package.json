{
  "name": "@modus/desktop",
  "version": "0.1.21",
  "description": "Local-first Modus desktop agent window.",
  "author": "Modus contributors",
  "homepage": "https://github.com/Stoltembergg/modus",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "npm run build:pty && npm run build:plugin-supervisor && npm run build:rea-supervisor && npm run build:sidecar && npm run build:renderer-web",
    "build:pty": "cargo build --release -p modus-pty-host",
    "build:plugin-supervisor": "node scripts/build-plugin-supervisor.mjs",
    "build:rea-supervisor": "node scripts/build-rea-supervisor.mjs",
    "build:sidecar": "npm run build:sidecar:index && npm run build:sidecar:tool-filter-worker",
    "build:sidecar:index": "esbuild src/sidecar/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=out/sidecar/index.js --alias:electron=./src/sidecar/electron-shim.ts --external:onnxruntime-node --external:vite --external:vitest --banner:js=\"import{createRequire as __modusCreateRequire}from'node:module';var require=__modusCreateRequire(import.meta.url);\"",
    "build:sidecar:tool-filter-worker": "esbuild src/main/local-models/tool-filter-worker.ts --bundle --platform=node --format=esm --target=node22 --outfile=out/sidecar/tool-filter-worker.js --alias:electron=./src/sidecar/electron-shim.ts --external:onnxruntime-node --external:vite --external:vitest --banner:js=\"import{createRequire as __modusCreateRequire}from'node:module';var require=__modusCreateRequire(import.meta.url);\"",
    "prepare:fast-codebase": "node scripts/prepare-fast-codebase.mjs",
    "package": "npm run prepare:fast-codebase && npm run build && npm run stage:bundle && npm run build:tauri",
    "stage:bundle": "node scripts/stage-bundle-bin.mjs",
    "package:mac": "npm run package",
    "package:win": "npm run package",
    "package:linux": "npm run package",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. apps/desktop/src apps/desktop/scripts",
    "check:case": "vitest run --root ../.. apps/desktop/scripts/case-collisions",
    "build:renderer-web": "vite build --config vite.renderer.config.ts",
    "dev:renderer-web": "vite --config vite.renderer.config.ts",
    "dev:tauri": "tauri dev",
    "build:tauri": "tauri build"
  },
  "devDependencies": {
    "@colbymchenry/codegraph": "^1.1.1",
    "@tailwindcss/node": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^3.0.0-alpha.6",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.8.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "44.5.1",
    "happy-dom": "^20.14.5",
    "js-yaml": "^5.4.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "^1.2.4",
    "@base-ui/react": "^1.5.0",
    "@composio/core": "^0.22.0",
    "@earendil-works/pi-ai": "0.80.6",
    "@earendil-works/pi-coding-agent": "0.80.6",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@huggingface/tokenizers": "0.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@pierre/diffs": "^1.5.1",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^2.0.0",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tabler/icons-react": "^3.44.0",
    "@tanstack/react-virtual": "3.14.13",
    "@tauri-apps/api": "^3.0.0-alpha.3",
    "@tryopenbot/agent-avatar": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "diff": "^9.0.0",
    "docx-preview": "^0.4.0",
    "exceljs": "^4.4.0",
    "katex": "^0.19.0",
    "lucide-react": "^1.70.0",
    "material-icon-theme": "^5.36.1",
    "monaco-editor": "^0.57.0",
    "motion": "^14.0.0",
    "onnxruntime-node": "1.30.0",
    "pdfjs-dist": "^6.1.200",
    "radix-ui": "^1.8.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "remark-breaks": "4.0.0",
    "semver": "^7.8.5",
    "streamdown": "^2.5.0",
    "thinking-orbs": "^0.3.2",
    "turndown": "^7.2.4",
    "typebox": "1.3.34",
    "zod": "^4.4.3"
  }
}